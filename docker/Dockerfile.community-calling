FROM node:24.22.1-alpine AS frontend
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN NODE_ENV=production pnpm exec vite build

# Reuse the released Community runtime and its compiled Ruby dependencies.
# Any lockfile additions are installed below; Enterprise code is excluded from the build context by CI.
FROM chatwoot/chatwoot:v4.19.1-ce@sha256:04895c7bd0550d9e74b45b7202787b56f7ee4e891ebbde0c429c8c32901b97cf
ARG SOURCE_COMMIT
ENV CW_EDITION=ce DISABLE_ENTERPRISE=true
WORKDIR /app
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs=2 --retry=3
COPY app ./app
COPY config ./config
COPY db ./db
COPY lib ./lib
COPY bin ./bin
COPY public ./public
COPY Rakefile LICENSE ./
COPY --from=frontend /app/public/vite ./public/vite
RUN test ! -d /app/enterprise && printf '%s\n' "$SOURCE_COMMIT" > .git_sha
